{
  "name": "evanpurkhiser.com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@evanpurkhiser/oxc-config": "^0.8.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0"
    }
  }
}
